{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CopilotBYOKManager",
  "version": "0.1.0",
  "identifier": "io.github.avalonero.copilotbyokmanager",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CopilotBYOKManager",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "publisher": "AvaloNero",
    "homepage": "https://github.com/Arcueid77/CopilotBYOKManager",
    "category": "DeveloperTool",
    "shortDescription": "Configure one provider. Publish it safely across your Copilot clients.",
    "icon": ["icons/icon.ico", "icons/icon.png", "icons/icon.icns"],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "SimpChinese"],
        "displayLanguageSelector": true,
        "startMenuFolder": "CopilotBYOKManager"
      }
    },
    "macOS": {
      "minimumSystemVersion": "15.0",
      "hardenedRuntime": true
    }
  }
}
