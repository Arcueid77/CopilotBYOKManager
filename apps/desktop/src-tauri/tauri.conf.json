{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CopilotBYOKManager",
  "version": "0.1.0",
  "identifier": "io.github.avalonero.copilotbyokmanager",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CopilotBYOKManager",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "active": false
  }
}
